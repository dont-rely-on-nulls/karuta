sort[[], []].
sort[[H | T], [HSorted | TSorted]] :-
  runs[[H | T], Runs],
  merge_all[Runs, [HSorted | TSorted]].

merge[[], [], []].
merge[[], [H | T], [H | T]].
merge[[H | T], [], [H | T]].
merge[[HL | TL], [HR | TR], [HL | TO]] :-
  merge[TL, [HR | TR], TO],
  karuta:leq[HL, HR].
merge[[HL | TL], [HR | TR], [HR | TO]] :-
  merge[[HL | TL], TR, TO],
  karuta:lt[HR, HL].

% FIXME: merge_all loops forever when you try to run it backwards
merge_all[[[H | T]], [H | T]].
merge_all[[A, B | More], [H | T]] :-
  merge_layer[[A, B | More], Merged],
  merge_all[Merged, [H | T]].

merge_layer[[], []].
merge_layer[[[H | T]], [[H | T]]].
merge_layer[[[HA | TA], [HB | TB] | More], [AB | Merged]] :-
  merge[[HA | TA], [HB | TB], AB],
  merge_layer[More, Merged].

runs[[A], [[A]]].
runs[[A, B | More], [[A | T] | Runs]] :-
  runs[[B | More], [T | Runs]],
  karuta:leq[A, B].
runs[[A, B | More], [[A] | Runs]] :-
  runs[[B | More], Runs],
  karuta:lt[B, A].

sort[[37, 11, 1000, 0, 3], Sorted]?
