sort[In, Out] :-
  % Reorder these calls if you want to run this backwards
  runs[In, Runs],
  merge_all[Runs, Out].

sorted[[]].
sorted[[_]].
sorted[[First, Second | More]] :- karuta:leq[First, Second], sorted[[Second | More]].

merge[[], [], []].
merge[[], [H | T], [H | T]] :- sorted[[H | T]].
merge[[H | T], [], [H | T]] :- sorted[[H | T]].
merge[[HL | TL], [HR | TR], [HL | TO]] :-
  merge[TL, [HR | TR], TO],
  karuta:leq[HL, HR].
merge[[HL | TL], [HR | TR], [HR | TO]] :-
  merge[[HL | TL], TR, TO],
  karuta:lt[HR, HL].

merge_all[In, Out] :- merge_all_loop[In, Out, Out].

merge_all_loop[[A], _, A] :- sorted[A].
merge_all_loop[[[HA | TA], [HB | TB] | More], [_ | Continue], [H | T]] :-
  % Reorder these calls if you want to run this backwards
  merge[[HA | TA], [HB | TB], AB],
  merge_all_loop[[AB | More], Continue, [H | T]].

runs[[], [[]]].
runs[[A], [[A]]].
runs[[A, B | More], [[A | T] | Runs]] :-
  runs[[B | More], [T | Runs]],
  karuta:leq[A, B].
runs[[A, B | More], [[A] | Runs]] :-
  runs[[B | More], Runs],
  karuta:lt[B, A].

sort[[37, 11, 1000, 0, 3], Sorted]?
