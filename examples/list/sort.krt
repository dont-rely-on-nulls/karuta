sort[In, Out] :-
  % Reorder these calls if you want to run this backwards
  runs[In, Runs],
  merge:all[Runs, Out].

sorted[[]].
sorted[[_]].
sorted[[First, Second | More]] :- karuta:leq[First, Second], sorted[[Second | More]].

:- module[merge] { all[_, _]. } {
  merge[[], [], []].
  merge[[], [H | T], [H | T]] :- sorted[[H | T]].
  merge[[H | T], [], [H | T]] :- sorted[[H | T]].
  merge[[HL | TL], [HR | TR], [HL | TO]] :-
    merge[TL, [HR | TR], TO],
    karuta:leq[HL, HR].
  merge[[HL | TL], [HR | TR], [HR | TO]] :-
    merge[[HL | TL], TR, TO],
    karuta:lt[HR, HL].

  all[In, Out] :- loop[In, Out, Out].

  loop[[A], _, A] :- sorted[A].
  loop[[A, B | More], [_ | Continue], [H | T]] :-
    % Reorder these calls if you want to run this backwards
    layer[[A, B | More], Merged],
    loop[Merged, Continue, [H | T]].

  layer[[], []].
  layer[[[H | T]], [[H | T]]].
  layer[[[HA | TA], [HB | TB] | More], [AB | Merged]] :-
    merge[[HA | TA], [HB | TB], AB],
    layer[More, Merged].
}.

runs[[], [[]]].
runs[[A], [[A]]].
runs[[A, B | More], [[A | T] | Runs]] :-
  runs[[B | More], [T | Runs]],
  karuta:leq[A, B].
runs[[A, B | More], [[A] | Runs]] :-
  runs[[B | More], Runs],
  karuta:lt[B, A].

sort[[37, 11, 1000, 0, 3], Sorted]?
